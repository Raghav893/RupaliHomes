# ── Supabase PostgreSQL ───────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → Database → Connection string (JDBC)
SPRING_DATASOURCE_URL=jdbc:postgresql://db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace-with-a-secret

# ── Backend ──────────────────────────────────────────────────
BACKEND_PORT=8080

# ── JWT ──────────────────────────────────────────────────────
APP_JWT_SECRET=replace-with-a-random-base64-secret-at-least-32-bytes
APP_JWT_EXPIRATION_MS=3600000
